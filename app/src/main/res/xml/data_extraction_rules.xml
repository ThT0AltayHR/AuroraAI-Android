<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ için veri çıkarma kuralları (bulut yedeği + cihazlar arası aktarım). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auroraai_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auroraai_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
